# Server-only. Set to your deployed FastAPI origin, without /user-service.
AUTH_API_URL=http://127.0.0.1:8000
# Must match FastAPI's refresh_token_cookie_name.
AUTH_REFRESH_COOKIE_NAME=refresh_token
APP_ORIGIN=http://localhost:3000

# Set in production, especially behind a reverse proxy. No trailing slash.
# APP_ORIGIN=https://your-frontend.example.com
